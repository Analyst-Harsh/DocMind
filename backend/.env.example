# Copy this file to .env and fill in the values.
#   cp .env.example .env

# --- OpenAI (required) ---------------------------------------------------
# Used for embeddings (default text-embedding-3-small) and chat completions
# (default gpt-4o-mini). No default — the app will fail to start without it.
OPENAI_API_KEY=

# --- Langfuse (required) --------------------------------------------------
# Tracing/observability. Get these from a Langfuse Cloud project or a
# self-hosted instance. No defaults — the app will fail to start without them.
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=

# --- OpenAI models (optional) ---------------------------------------------
# EMBEDDING_MODEL=text-embedding-3-small   # or BAAI/bge-large-en-v1.5 for local embeddings
# LLM_MODEL=gpt-4o-mini
# DRAFT_GENERATE_LLM_MODEL=gpt-4o

# --- Retrieval (optional) -------------------------------------------------
# USE_RERANKER=true

# --- Tracing (optional) ---------------------------------------------------
# ENABLE_TRACING=false

# --- Qdrant (optional) -----------------------------------------------------
# QDRANT_HOST=localhost
# QDRANT_PORT=6333
# QDRANT_COLLECTION=docmind

# --- Redis / semantic cache (optional) --------------------------------------
# REDIS_HOST=localhost
# REDIS_PORT=6379
# ENABLE_SEMANTIC_CACHE=false
# SEMANTIC_CACHE_TTL_SECONDS=86400
# SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.75

# --- Neo4j / GraphRAG (optional, eval scripts only) -------------------------
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=password
# NEO4J_DATABASE=neo4j

# --- GitHub repo ingestion (optional) ---------------------------------------
# A fine-grained PAT with read access to the repos you'll ingest. Without
# it, only public repos work and the GitHub API is capped at 60 req/hr
# (vs. 5000/hr authenticated).
# GITHUB_TOKEN=
# INGEST_JOB_TTL_SECONDS=604800
